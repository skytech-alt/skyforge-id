// skyforge-id

функция сгенерировать_простой_id(длина) {
    пусть алфавит = "0123456789abcdef"
    пусть результат = ""
    пусть энтропия = время_сейчас()
    
    для i от 1 до длина {
        пусть индекс = (энтропия + i * 17) % длина(алфавит)
        результат = результат + алфавит[индекс]
    }
    вернуть результат
}

функция сгенерировать_числовой_id() {
    вернуть время_сейчас()
}
